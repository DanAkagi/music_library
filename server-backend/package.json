{
  "name": "music-library-backend",
  "version": "1.0.0",
  "description": "Music library backend server",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only server/index.ts",
    "build": "tsc",
    "start": "node dist/server/index.js",
    "lint": "eslint . --ext .ts",
    "db:migrate-csv": "ts-node scripts/migrate-csv-to-mysql.ts",
    "db:reset": "ts-node scripts/reset-database.ts"
  },
  "dependencies": {
    "amqplib": "^0.10.4",
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "music-metadata": "^10.5.0",
    "mysql2": "^3.22.5",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/archiver": "^6.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
